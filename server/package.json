{
  "name": "tailor-fit-server",
  "version": "1.0.0",
  "description": "Tailor Fit - API Server",
  "author": "Sandeep for Darosoft",
  "license": "ISC",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": "^10.30.0"
  },
  "scripts": {
    "postinstall": "node ../scripts/deploy-checklist.cjs",
    "postbuild": "node ../scripts/deploy-checklist.cjs",
    "start": "tsx server.ts",
    "start:prod": "node dist/server.js",
    "build": "tsc --outDir dist",
    "dev": "tsx watch server.ts",
    "seed": "tsx utils/seedData.ts",
    "seed:pants": "tsx utils/seedPants.ts",
    "seed:products": "tsx scripts/seed_products.ts",
    "seed:products:shirt": "tsx scripts/seed_products.ts --shirt",
    "seed:products:pant": "tsx scripts/seed_products.ts --pant",
    "seed:products:3d": "tsx scripts/seed_products.ts --3d",
    "admin:delete-user": "tsx scripts/delete_user.ts",
    "admin:delete-product": "tsx scripts/delete_product.ts",
    "admin:delete-fabric": "tsx scripts/delete_fabric.ts",
    "admin:render-thumbnails": "tsx scripts/render_all_thumbnails.ts",
    "admin:reset-password": "tsx scripts/reset_admin_password.ts",
    "admin:migrate-urls": "tsx scripts/migrate_legacy_urls.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "gltfpack": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "socket.io": "^4.8.3",
    "three": "^0.170.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.170.0",
    "canvas": "^3.2.1",
    "gl": "^8.0.2",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}