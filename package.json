{
  "name": "tailor-fit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tailor Fit - Premium Custom Clothing Platform",
  "author": "Sandeep for Darosoft",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": "^10.30.0"
  },
  "scripts": {
    "postinstall": "node scripts/deploy-checklist.cjs",
    "postbuild": "node scripts/deploy-checklist.cjs",
    "postbuild:server": "node scripts/deploy-checklist.cjs",
    "postbuild:all": "node scripts/deploy-checklist.cjs",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\"",
    "client": "vite --host",
    "server": "cd server && pnpm run dev",
    "ngrok": "ngrok start --config \"$(ngrok config check | awk '{print $NF}')\" --config ngrok.yml tailor-fit-api",
    "build": "pnpm install && pnpm --filter server install && vite build && cd server && pnpm run build",
    "build:server": "cd server && pnpm run build",
    "build:all": "pnpm install && pnpm --filter server install && concurrently \"vite build\" \"cd server && pnpm run build\"",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode prod",
    "clean:mobile-assets": "rm -rf dist/models dist/hdri dist/tailor-fit-darosoft-assets",
    "build:mobile": "pnpm run build && pnpm run clean:mobile-assets && pnpm cap sync",
    "build:mobile:staging": "pnpm run build:staging && pnpm run clean:mobile-assets && pnpm cap sync",
    "build:mobile:prod": "pnpm run build:prod && pnpm run clean:mobile-assets && pnpm cap sync",
    "android": "pnpm run build:mobile && pnpm cap open android",
    "android:staging": "pnpm run build:mobile:staging && pnpm cap open android",
    "android:prod": "pnpm run build:mobile:prod && pnpm cap open android",
    "ios": "pnpm run build:mobile && pnpm cap open ios",
    "cap:sync": "pnpm cap sync",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "cd server && pnpm run start",
    "test": "vitest --config vite.config.ts --run",
    "test:server": "cd server && vitest run --config vitest.config.ts",
    "test:all": "vitest --config vite.config.ts --run && cd server && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/status-bar": "^8.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
